<?xml version="1.0" encoding="UTF-8"?>
<!--
  The gate in a Kafka proxy: a Kroxylicious filter that judges every record
  of a produce request before it reaches a broker, and refuses a batch that
  breaks the contract back to its producer. The shaded jar carries the gate
  and Chicory; the proxy supplies its API, the Kafka client and logging.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.mancube.covenant</groupId>
    <artifactId>covenant-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>covenant-kroxylicious</artifactId>
  <name>Covenant for Kroxylicious</name>
  <description>A Kroxylicious filter that enforces a Covenant data contract on produce requests.</description>

  <dependencies>
    <dependency>
      <groupId>net.mancube.covenant</groupId>
      <artifactId>covenant-jvm</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.kroxylicious</groupId>
      <artifactId>kroxylicious-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
